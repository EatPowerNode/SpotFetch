{
  "manifest_version": 3,
  "name": "Precious Metals Spot Price Fetch",
  "version": "1.3",
  "description": "Insert live gold and silver spot prices via crypto tokens. Firefox/Mullvad compatible.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.coingecko.com/*",
    "*://*.x.com/*",
    "*://*.gab.com/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
